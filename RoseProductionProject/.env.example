# Copy to .env and fill in real values. Never commit .env.

# --- MySQL (Docker container Mysqlcontainer) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=RoseProductionDB
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# --- API authentication (X-API-Key header and GUI sign-in) ---
API_KEY=replace_with_a_long_random_value

# --- Optional (defaults shown) ---
# Signs the GUI session cookie. If unset, a random key is generated at
# start-up and GUI users must sign in again after every restart.
# SECRET_KEY=replace_with_another_long_random_value
# SESSION_HOURS=8
# SESSION_COOKIE_SECURE=false   # set to true only when served over HTTPS
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=300
